# Rust build outputs
/target/
**/*.rs.bk

# Node / Vite / SDK build outputs
node_modules/
/web/dist/
/packages/*/dist/
/plugins/*/ui/dist/
/playwright-report/
/test-results/
*.tsbuildinfo

# Local runtime state & secrets
.biocompass/
.env
.env.*
!.env.example
.sunfire/

# Downloaded offline DuckDB extensions (454 MB binaries, fetched per-platform)
/vendor/duckdb-extensions/*
!/vendor/duckdb-extensions/v2.0.0.sha256
*.duckdb_extension

# OS & editor artifacts
.DS_Store
.build/
*.swp
